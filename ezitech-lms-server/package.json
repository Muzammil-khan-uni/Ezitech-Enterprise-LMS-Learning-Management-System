{
  "name": "ezitech-lms-server",
  "version": "0.1.0",
  "private": true,
  "description": "Ezitech Enterprise LMS - API server",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "lint": "eslint src --ext .js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:noDb": "jest --config jest.noDb.config.js",
    "payments:clear-mock": "node src/scripts/clearMockPayments.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true,
    "@parcel/watcher@2.6.0": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "glob": "^13.0.6",
    "exceljs": {
      "fast-csv": "^5.0.7",
      "tmp": "^0.2.7",
      "archiver": "$archiver",
      "unzipper": "^0.12.5",
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "cloudinary": "^2.4.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "mongoose": "^8.4.0",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.7.5",
    "speakeasy": "^2.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.0",
    "jest": "^30.5.2",
    "js-yaml": "^4.1.0",
    "supertest": "^7.0.0",
    "mongodb-memory-server": "^10.0.0",
    "ioredis-mock": "^8.9.0"
